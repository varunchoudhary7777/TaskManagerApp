const API_URL = (
  import.meta.env.VITE_API_URL ?? "http://localhost:8001"
).replace(/\/$/, "");import type { ApiErrorShape, TokenPair } from "../types/api";

const API_URL = (import.meta.env.VITE_API_URL ?? "http://127.0.0.1:8000").replace(/\/$/, "");
const WS_URL = (import.meta.env.VITE_WS_URL ?? "ws://127.0.0.1:8000").replace(/\/$/, "");
const TOKENS_KEY = "taskflow.tokens";

export class ApiError extends Error {
  constructor(
    message: string,
    public readonly status: number,
    public readonly fields?: ApiErrorShape["errors"],
  ) {
    super(message);
  }
}

export function getTokens(): TokenPair | null {
  const raw = localStorage.getItem(TOKENS_KEY);
  if (!raw) return null;
  try {
    return JSON.parse(raw) as TokenPair;
  } catch {
    localStorage.removeItem(TOKENS_KEY);
    return null;
  }
}

export function saveTokens(tokens: TokenPair) {
  localStorage.setItem(TOKENS_KEY, JSON.stringify(tokens));
}

export function clearTokens() {
  localStorage.removeItem(TOKENS_KEY);
}

function url(path: string, query?: Record<string, string | number | boolean | undefined | null>) {
  const target = new URL(`${API_URL}${path}`);
  Object.entries(query ?? {}).forEach(([key, value]) => {
    if (value !== undefined && value !== null && value !== "") target.searchParams.set(key, String(value));
  });
  return target.toString();
}

async function readError(response: Response) {
  const body = (await response.json().catch(() => ({}))) as ApiErrorShape;
  const fieldErrors = body.errors?.map((item) => `${item.field}: ${item.message}`).join(" · ");
  return new ApiError(fieldErrors || body.detail || "The request could not be completed.", response.status, body.errors);
}

async function refreshToken() {
  const tokens = getTokens();
  if (!tokens?.refresh_token) return null;
  const response = await fetch(url("/auth/refresh"), {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ refresh_token: tokens.refresh_token }),
  });
  if (!response.ok) {
    clearTokens();
    return null;
  }
  const newTokens = (await response.json()) as TokenPair;
  saveTokens(newTokens);
  return newTokens;
}

export async function request<T>(
  path: string,
  options: RequestInit & { query?: Record<string, string | number | boolean | undefined | null>; retry?: boolean } = {},
): Promise<T> {
  const { query, retry = true, headers, body, ...requestOptions } = options;
  const tokens = getTokens();
  const finalHeaders = new Headers(headers);
  if (tokens?.access_token) finalHeaders.set("Authorization", `Bearer ${tokens.access_token}`);
  if (body && !(body instanceof FormData) && !finalHeaders.has("Content-Type")) {
    finalHeaders.set("Content-Type", "application/json");
  }

  const response = await fetch(url(path, query), { ...requestOptions, headers: finalHeaders, body });
  if (response.status === 401 && retry && tokens?.refresh_token && path !== "/auth/refresh") {
    const renewed = await refreshToken();
    if (renewed) return request<T>(path, { ...options, retry: false });
  }
  if (!response.ok) throw await readError(response);
  if (response.status === 204) return undefined as T;
  return (await response.json()) as T;
}

export async function download(path: string, filename: string) {
  const tokens = getTokens();
  const response = await fetch(url(path), {
    headers: tokens?.access_token ? { Authorization: `Bearer ${tokens.access_token}` } : undefined,
  });
  if (!response.ok) throw await readError(response);
  const blobUrl = URL.createObjectURL(await response.blob());
  const anchor = document.createElement("a");
  anchor.href = blobUrl;
  anchor.download = filename;
  anchor.click();
  URL.revokeObjectURL(blobUrl);
}

export function createNotificationSocket(onMessage: (payload: unknown) => void) {
  const token = getTokens()?.access_token;
  if (!token) return null;
  const socket = new WebSocket(`${WS_URL}/ws/notifications?token=${encodeURIComponent(token)}`);
  socket.addEventListener("message", (event) => {
    try {
      onMessage(JSON.parse(event.data));
    } catch {
      // Ignore non-JSON keepalive messages.
    }
  });
  return socket;
}

export { API_URL };
